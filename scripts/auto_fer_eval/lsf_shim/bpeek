#!/usr/bin/env python3
"""
LSF Shim bpeek Command
Outputs the current job log contents for a running job.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lsf_registry import LsfRegistry


def main() -> None:
    job_id = None
    for arg in sys.argv[1:]:
        if arg.startswith("-"):
            continue
        try:
            job_id = int(arg)
            break
        except ValueError:
            continue

    if job_id is None:
        print("Usage: bpeek [options...] <job_id>", file=sys.stderr)
        raise SystemExit(1)

    registry = LsfRegistry()
    job = registry.get_job(job_id)
    if job is None:
        print(f"Job <{job_id}> is not found", file=sys.stderr)
        raise SystemExit(1)

    log_path = Path(str(job.get("log_path") or ""))
    if not log_path.exists():
        raise SystemExit(0)

    try:
        sys.stdout.write(log_path.read_text(encoding="utf-8", errors="replace"))
    except Exception as exc:
        print(f"bpeek failed for job <{job_id}>: {exc}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()

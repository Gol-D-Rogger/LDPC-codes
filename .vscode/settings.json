{
    "chatgpt.openOnStartup": false,
    // ============ clangd 配置 ============
    // 禁用 Microsoft C++ IntelliSense，使用 clangd
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    // clangd 扩展配置
    "clangd.arguments": [
        // 使用编译命令数据库
        "--compile-commands-dir=${workspaceFolder}/gen4_ldpc_sim",
        // 启用后台索引
        "--background-index",
        // 启用 clang-tidy
        "--clang-tidy",
        // 支持补全中的片段
        "--completion-style=detailed",
        // 启用函数签名提示
        "--all-scopes-completion",
        // 启用不完整的行补全
        "--completion-parse=auto"
    ],
    // clangd 启用 InlayHints（参数名和类型提示）
    "clangd.inlayHints.enabled": true,
    "clangd.inlayHints.parameters": true,
    "clangd.inlayHints.deducedTypes": true,
    // 启用符号大纲
    "outline.showKeys": true,
    "outline.showValues": true,
    // C/C++ 文件关联
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.c": "c"
    },
    // 编辑器设置
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "clangd"
    },
    // 代码诊断显示
    "problems.showCurrentInEditor": true
}
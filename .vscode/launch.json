{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            // "program": "${workspaceFolder}/GenLDPC/ldpc_gen",
            // "args": ["149", "129", "1"],
            // "program": "${workspaceFolder}/gen4_ldpc_sim/ssd_fc_dq",
            // "args": ["LDPC", "${workspaceFolder}/gen4_ldpc_sim/config/sdec_dq.cnfg", "AWGN", "5.0", "2", "/workspaces/LDPC-codes/GenLDPC/output"],
            "program": "${workspaceFolder}/IBEX/ssd_fc",
            "args": [
                "LDPC",
                "${workspaceFolder}/IBEX/config/Ibex_hd_row8.cnfg",
                "AWGN",
                "5.1"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}